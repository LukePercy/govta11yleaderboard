# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,css,html,json}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.md]
# Trailing spaces are intentional in Markdown (line-break syntax)
trim_trailing_whitespace = false
